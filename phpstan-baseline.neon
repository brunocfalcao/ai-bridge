parameters:
	ignoreErrors:
		-
			message: '#^Offset ''content'' on array\{role\: string, content\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Resolver/AiResolver.php

		-
			message: '#^Offset ''role'' on array\{role\: string, content\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Resolver/AiResolver.php

		-
			message: '#^Parameter \#1 \$array \(list\<Laravel\\Ai\\Messages\\AssistantMessage\|Laravel\\Ai\\Messages\\UserMessage\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: src/Resolver/AiResolver.php

		-
			message: '#^Parameter \#1 \$provider of class Laravel\\Ai\\Events\\ProviderFailedOver constructor expects Laravel\\Ai\\Providers\\Provider, Laravel\\Ai\\Contracts\\Providers\\EmbeddingProvider given\.$#'
			identifier: argument.type
			count: 1
			path: src/Resolver/AiResolver.php

		-
			message: '#^Call to an undefined method Laravel\\Ai\\AnonymousAgent\:\:providerOptions\(\)\.$#'
			identifier: method.notFound
			count: 3
			path: tests/Unit/Resolver/ConnectionSettingsTest.php

		-
			message: '#^Call to an undefined method Laravel\\Ai\\Contracts\\Agent\:\:messages\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: tests/Unit/Resolver/StreamTest.php

		-
			message: '#^Call to an undefined method Laravel\\Ai\\Contracts\\Agent\:\:providerOptions\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: tests/Unit/Resolver/StreamTest.php
