{
    "name": "brunocfalcao/ai-bridge",
    "description": "Reusable AI bridge for Laravel: multi-provider connectivity, chat streaming, knowledge/MCP server, and agent tools.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/ai": "^1.0 || 1.x-dev",
        "laravel/mcp": "^1.0",
        "prism-php/prism": "^0.71 || ^0.99"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "nunomaduro/phpinsights": "^2.15",
        "phpmd/phpmd": "3.x-dev#7e875c94bc8db9ffd55e6615e88a76fdb2ff8068",
        "pdepend/pdepend": "3.x-dev#2cdfa2dab627b79c8ee74146821bb65307a5bd30",
        "larastan/larastan": "^3.12",
        "phpstan/phpstan": "^2.2",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "phpstan/phpstan-mockery": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "BrunoCFalcao\\AiBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BrunoCFalcao\\AiBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BrunoCFalcao\\AiBridge\\AiBridgeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "./run-pest-tia.sh --filtered",
        "test:full": "./run-pest-tia.sh --fresh",
        "quality": [
            "@php -d memory_limit=2G quality-gate.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    }
}
